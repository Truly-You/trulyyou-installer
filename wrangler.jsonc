{
  "name": "trulyyou-dashboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "DASHBOARD",
        "class_name": "Dashboard"
      },
      {
        "name": "STATE",
        "class_name": "DashboardState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Dashboard",
        "DashboardState"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "Dashboard",
      "image": "ghcr.io/truly-you/trulyyou-dashboard@sha256:df7ae7608af76a6ea67450f99e98a8de39bbaed2fb74e6d6c90637d56989fe9e",
      "max_instances": 1,
      "instance_type": "standard-2"
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "PROVISIONING_TOKEN"
    ]
  },
  "vars": {
    "OWNER_EMAIL": "",
    "DASHBOARD_HOSTNAME": "",
    "SIGNIN_HOSTNAME": "",
    "CLOUDFLARE_ACCOUNT_ID": "",
    "CLOUDFLARE_ZONE_ID": "",
    "INSTALL_CODE": ""
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  }
}
