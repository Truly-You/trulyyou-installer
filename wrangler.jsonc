{
  "name": "trulyyou-dashboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "DASHBOARD",
        "class_name": "Dashboard"
      },
      {
        "name": "STATE",
        "class_name": "DashboardState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Dashboard",
        "DashboardState"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "Dashboard",
      "image": "ghcr.io/truly-you/trulyyou-dashboard@sha256:5a6a09a59c58d1cb031267bba559ccfcda42e8baba41f709337bbbdcb6c62f39",
      "max_instances": 1,
      "instance_type": "standard-2"
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "PROVISIONING_TOKEN"
    ]
  },
  "vars": {
    "OWNER_EMAIL": "",
    "DASHBOARD_HOSTNAME": "",
    "SIGNIN_HOSTNAME": "",
    "CLOUDFLARE_ACCOUNT_ID": "",
    "CLOUDFLARE_ZONE_ID": "",
    "COMPANY_NAME": ""
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  }
}
